# ===============================
# ENVIRONMENT
# ===============================
DEBUG=true

# ===============================
# DATABASE CONFIGURATION
# ===============================
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=digidat
MYSQL_USER=digidat_user
MYSQL_PASSWORD=digidat_password

# --- PRODUCTION AWS RDS ---
# MYSQL_HOST=your-rds-endpoint.amazonaws.com
# MYSQL_PORT=3306

# --- PRODUCTION DOCKER ---
MYSQL_HOST=db
MYSQL_PORT=3306

# --- DEVELOPMENT ---
# MYSQL_HOST=localhost
# MYSQL_PORT=3307

# ===============================
# SECURITY / AUTH
# ===============================
SECRET_KEY=change_this_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===============================
# AWS S3 CONFIGURATION
# ===============================
AWS_REGION=us-east-1
AWS_BUCKET_NAME=digidat-backend-storage

# ===============================
# CORS CONFIGURATION
# ===============================
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# ===============================
# FIRST SUPERUSER
# ===============================
FIRST_SUPERUSER=admin@test.com
FIRST_SUPERUSER_PASSWORD=admin123
