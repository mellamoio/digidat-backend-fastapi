# Configuración de la aplicación
PROJECT_NAME="DigiDat"
DEBUG=True

# Configuración de la base de datos
DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost:3306/digidat_db?charset=utf8mb4

# Configuración de seguridad
SECRET_KEY=tu_clave_secreta_muy_larga_y_segura_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 horas

# Configuración de CORS (separar por comas sin espacios)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Configuración de correo (opcional)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña
EMAILS_FROM_EMAIL=tu_correo@gmail.com
EMAILS_FROM_NAME="DigiDat"

# Primer usuario administrador
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=ContraseñaSegura123
